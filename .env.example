# Smart OSM Environment Configuration
# Copy this file to .env and fill in your actual values for local development

# Google Maps API Key
# Required for: OSM Map display and location features
# Get your key from: https://console.cloud.google.com/apis/credentials
# For CI/CD: Uses placeholder value (maps won't function, but build works)
MAPS_API_KEY=YOUR_MAPS_API_KEY_HERE

# Firebase App Check Debug Token (for development)
# Required if using Firebase App Check for debug builds
# Leave blank for CI/CD builds without Firebase
FIREBASE_APPCHECK_DEBUG_TOKEN=

# Gemini API Key (optional)
# Required only if using Gemini AI features
# Get your key from: https://ai.google.dev/
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
